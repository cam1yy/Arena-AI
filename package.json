{
  "name": "localy",
  "private": true,
  "version": "1.0.0",
  "description": "Localy - discover local businesses without websites and manage personalized outreach.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c gray,gray,gray \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @localy/api",
    "dev:worker": "npm run dev -w @localy/worker",
    "dev:web": "npm run dev -w @localy/web",
    "db:start": "tsx scripts/dev-db.ts",
    "db:generate": "npm run generate -w @localy/database",
    "db:migrate": "npm run migrate -w @localy/database",
    "db:seed": "npm run seed -w @localy/database",
    "db:setup": "npm run setup -w @localy/database",
    "admin:grant": "npm run admin:grant -w @localy/database --",
    "build": "npm run build -w @localy/web && npm run build -w @localy/api && npm run build -w @localy/worker",
    "start:api": "npm run start -w @localy/api",
    "start:worker": "npm run start -w @localy/worker",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.19.0",
    "concurrently": "^10.0.5",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
