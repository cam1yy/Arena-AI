# ---------------------------------------------------------------------------
# Localy environment configuration
# Copy to .env and fill in real values. Never commit .env.
# Features whose credentials are missing are shown as "not configured" in the
# app with the exact variables required; nothing is mocked.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# Public URLs. APP_URL is where the web app is served; API_URL is the API's
# public origin (used for OAuth redirect URIs and unsubscribe links). In a
# single-origin deployment both are the same.
APP_URL=http://localhost:5173
API_URL=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated list of allowed browser origins (defaults to APP_URL).
CORS_ORIGINS=
COOKIE_DOMAIN=
TRUST_PROXY=true
# Only needed when the app is embedded in a cross-site iframe or the web app
# and API are on different sites: COOKIE_SAMESITE=none (requires HTTPS).
COOKIE_SAMESITE=lax
COOKIE_PARTITIONED=false
# CSP frame-ancestors sources (space separated). Defaults to same-origin only.
FRAME_ANCESTORS='self'

# PostgreSQL. `npm run db:start` runs a local development server on 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/localy
DATABASE_POOL_MAX=10

# Secrets. Generate with: openssl rand -base64 48 (session) / openssl rand -base64 32 (encryption)
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
SESSION_TTL_DAYS=30
# AES-256-GCM key for OAuth tokens and 2FA secrets. Must decode to 32 bytes.
EMAIL_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Google Maps Platform
# Server key: Places API (New) + Geocoding API. Restrict by IP address. Never exposed to browsers.
GOOGLE_MAPS_API_KEY=
# Browser key: Maps JavaScript API only. Restrict by HTTP referrer to your APP_URL.
GOOGLE_MAPS_BROWSER_KEY=
# Optional Map ID for Advanced Markers and cloud styling.
GOOGLE_MAPS_MAP_ID=
GOOGLE_PLACES_LANGUAGE=en
# Optional two-letter region code to bias results (for example ZA, US, GB).
GOOGLE_PLACES_REGION=
PLACES_REQUESTS_PER_SECOND=8

# Google OAuth (Google sign-in and Gmail sending).
# Authorized redirect URI: ${API_URL}/api/oauth/google/callback
# Scopes requested for Gmail: gmail.send, gmail.readonly, openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Outlook / Microsoft 365) via Microsoft Entra ID.
# Redirect URI: ${API_URL}/api/oauth/microsoft/callback
# Delegated permissions: Mail.Send, Mail.Read, User.Read, offline_access, openid, email, profile
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Stripe billing. Create one recurring Price per paid plan and set the IDs.
# Webhook endpoint: ${API_URL}/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.created,
#         customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_AGENCY=

# System email (verification, password reset, invitations, notifications).
# Example: smtps://user:pass@smtp.example.com:465
# Without SMTP_URL in development, messages appear in the in-app developer outbox (/dev/mail).
SMTP_URL=
MAIL_FROM="Localy <no-reply@example.com>"
SUPPORT_EMAIL=support@example.com

# Optional AI assistance (drafts and rewrites are always reviewed before sending).
# AI_PROVIDER=openai | anthropic | none
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Development sandbox mailbox (records sends without delivering). Always off in production.
ENABLE_DEV_EMAIL_SANDBOX=true
WORKER_CONCURRENCY=4
TRIAL_DAYS=14
